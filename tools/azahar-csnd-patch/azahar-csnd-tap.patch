+void CSND_SND::DumpChannelAudio(u32 index) {
+    const Channel& c = channels[index];
+
+    if (c.block1_address == 0 || c.block1_size == 0) {
+        LOG_WARNING(Service_CSND, "channel {} started with no sample block", index);
+        return;
+    }
+
+    // block1_address is a PHYSICAL address -- CSND is a DMA engine and reads
+    // guest memory directly. This is exactly the pointer the guest supplied,
+    // so a bad VA->PA conversion on the guest side shows up here as garbage.
+    u8* src = system.Memory().GetPhysicalPointer(c.block1_address);
+    if (src == nullptr) {
+        LOG_ERROR(Service_CSND, "channel {} block1_address {:#010X} is unmapped", index,
+                  c.block1_address);
+        return;
+    }
+
+    std::vector<s16> pcm;
+    switch (c.encoding) {
+    case Encoding::Pcm16:
+        pcm.resize(c.block1_size / sizeof(s16));
+        std::memcpy(pcm.data(), src, pcm.size() * sizeof(s16));
+        break;
+    case Encoding::Pcm8:
+        pcm.resize(c.block1_size);
+        for (std::size_t i = 0; i < pcm.size(); ++i) {
+            pcm[i] = static_cast<s16>(static_cast<s8>(src[i])) << 8;
+        }
+        break;
+    default:
+        LOG_WARNING(Service_CSND, "channel {} uses encoding {} which the tap does not decode",
+                    index, static_cast<u32>(c.encoding));
+        return;
+    }
+
+    static u32 dump_counter = 0;
+    const std::string path =
+        FileUtil::GetUserPath(FileUtil::UserPath::UserDir) +
+        "csnd_dump_" + std::to_string(dump_counter++) + ".wav";
+
+    // CSND's "sample rate" field is not Hz -- it is a timer divider, and the
+    // hardware derives the rate from it. Writing the raw divider into a WAV
+    // header produces a file that plays at roughly a seventh of the intended
+    // speed, which looks alarming and is purely cosmetic.
+    const u32 hz = (c.sample_rate != 0) ? (0x03FEC3FCu / c.sample_rate) : 0;
+
+    WriteWavFile(path, pcm, hz);
+
+    LOG_INFO(Service_CSND,
+             "CSND TAP: channel={} paddr={:#010X} bytes={} samples={} rate={} "
+             "encoding={} volL={} volR={} loop={} -> {}",
+             index, c.block1_address, c.block1_size, pcm.size(), hz,
+             static_cast<u32>(c.encoding), c.left_channel_volume, c.right_channel_volume,
+             static_cast<u32>(c.loop_mode), path);
+}
+
 } // namespace Service::CSND
