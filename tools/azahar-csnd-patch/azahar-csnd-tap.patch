+// ---------------------------------------------------------------------------
+// CSND audio tap  (added for XYORAS Access verification)
+//
+// Azahar tracks all CSND channel state but never renders it -- CommandId::Start
+// is a no-op, so CSND is silent. That makes the emulator useless for testing
+// anything that uses CSND, which is the only audio path available to 3GX game
+// plugins.
+//
+// This does not implement mixing. It writes the samples a channel WOULD play
+// to a .wav file when the channel is started, which is enough to verify that
+// the guest handed CSND correct audio at the correct rate.
+// ---------------------------------------------------------------------------
+namespace {
+
+void WriteWavFile(const std::string& path, const std::vector<s16>& pcm, u32 sample_rate) {
+    FileUtil::IOFile f(path, "wb");
+    if (!f.IsOpen()) {
+        return;
+    }
+
+    const u32 data_bytes = static_cast<u32>(pcm.size() * sizeof(s16));
+    const u32 byte_rate = sample_rate * 2;
+    u8 header[44];
+    std::memcpy(header + 0, "RIFF", 4);
+    const u32 riff_size = 36 + data_bytes;
+    std::memcpy(header + 4, &riff_size, 4);
+    std::memcpy(header + 8, "WAVEfmt ", 8);
+    const u32 fmt_size = 16;
+    std::memcpy(header + 16, &fmt_size, 4);
+    const u16 fmt_pcm = 1, channels_n = 1, block_align = 2, bits = 16;
+    std::memcpy(header + 20, &fmt_pcm, 2);
+    std::memcpy(header + 22, &channels_n, 2);
+    std::memcpy(header + 24, &sample_rate, 4);
+    std::memcpy(header + 28, &byte_rate, 4);
+    std::memcpy(header + 32, &block_align, 2);
+    std::memcpy(header + 34, &bits, 2);
+    std::memcpy(header + 36, "data", 4);
+    std::memcpy(header + 40, &data_bytes, 4);
+
+    f.WriteBytes(header, sizeof(header));
+    f.WriteBytes(pcm.data(), data_bytes);
+}
+
+} // Anonymous namespace
+
 SERVICE_CONSTRUCT_IMPL(Service::CSND::CSND_SND)
 SERIALIZE_EXPORT_IMPL(Service::CSND::CSND_SND)
 
